# Dependencies and builds
node_modules/
dist/
*.log

# Secrets and local settings: keep only the .env.example templates
.env
.env.*
!.env.example

# Files uploaded through the app (article photos…)
backend/uploads/*
!backend/uploads/.gitkeep

# Local Claude Code tooling
.claude/

# OS / editors
.DS_Store
Thumbs.db

# Android release signing (never commit: losing or leaking the key blocks updates)
*.jks
*.keystore
keystore.properties

# Dossier vide créé par le build Vercel (le preset « Other » en exige un).
backend/public/
