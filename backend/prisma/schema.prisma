// Schema de la base de données centrale (PostgreSQL)
// Toutes les entités synchronisables utilisent un id UUID (généré côté mobile
// si créées hors-ligne) + updatedAt/deletedAt pour permettre une synchronisation
// incrémentale (delta sync) fiable entre le backend et la base locale SQLite du mobile.

generator client {
  provider      = "prisma-client-js"
  // rhel-openssl-3.0.x : moteur des fonctions Vercel.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Connexion directe (sans pooler) pour les migrations ; avec Neon sur Vercel,
  // l'intégration fournit DATABASE_URL (poolée) et DATABASE_URL_UNPOOLED.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  ADMIN
  VENDEUR
}

enum TypeVente {
  COMPTANT
  CREDIT
}

enum ModePaiement {
  ESPECES
  CHEQUE
  VIREMENT
  TPE
}

enum StatutFacture {
  VALIDEE
  ANNULEE
}

// Effet sur le stock camion : CHARGEMENT +, RETOUR (camion -> dépôt) -,
// VENTE -, RETOUR_CLIENT (produit repris chez un client) +, AJUSTEMENT signé.
enum SensMouvementStock {
  CHARGEMENT
  RETOUR
  VENTE
  AJUSTEMENT
  RETOUR_CLIENT
}

// Mouvements du dépôt central : réception fournisseur (ENTREE), sortie vers un
// camion (CHARGEMENT), retour des invendus d'un camion (RETOUR).
enum SensMouvementDepot {
  ENTREE
  CHARGEMENT
  RETOUR
  AJUSTEMENT
}

enum StatutInventaire {
  EN_COURS
  VALIDE
}

// Justification d'un écart d'inventaire, saisie par l'admin.
enum MotifEcart {
  ENDOMMAGE
  PERDU
  ECHANTILLON
  AUTRE
}

// Société (entreprise) gérée par l'admin : chacune a ses propres articles,
// clients, dépôt, vendeurs (et donc camions) et bons. L'admin passe de l'une à
// l'autre ; un vendeur appartient à une seule société.
model Societe {
  id              String    @id @default(uuid())
  // Préfixe des comptes vendeurs (RC → RC-V001) : codes uniques dans toute l'app.
  code            String    @unique
  nom             String
  activite        String?
  matriculeFiscal String?
  adresse         String?
  telephone       String?
  logo            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  articles    Article[]
  clients     Client[]
  users       User[]
  entrees     EntreeDepot[]
  inventaires Inventaire[]
  categories  Categorie[]
  entrepot    Entrepot?

  @@map("societes")
}

model User {
  id               String   @id @default(uuid())
  code             String   @unique
  nom              String
  email            String?  @unique
  telephone        String?
  // Société du vendeur ; l'admin (null) gère toutes les sociétés.
  societeId        String?
  societe          Societe? @relation(fields: [societeId], references: [id])
  // Véhicule du vendeur, imprimé sur ses bons de sortie.
  voiture          String?
  matriculeVoiture String?
  passwordHash     String
  role             Role     @default(VENDEUR)
  actif            Boolean  @default(true)
  // Incrémenté à la désactivation du compte ou au changement de mot de passe :
  // les jetons émis avant deviennent invalides (déconnexion immédiate).
  sessionVersion   Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  stockCamion      StockCamion[]
  chargements      ChargementCamion[]
  factures         Facture[]
  paiements        Paiement[]
  visites          Visite[]
  mouvementsStock  MouvementStock[]
  mouvementsDepot  MouvementDepot[]   @relation("MouvementDepotVendeur")
  entreesDepot     EntreeDepot[]      @relation("EntreeDepotAdmin")
  inventaires      Inventaire[]       @relation("InventaireVendeur")
  inventairesFaits Inventaire[]       @relation("InventaireAdmin")

  @@map("users")
}

model Article {
  id              String               @id @default(uuid())
  societeId       String
  societe         Societe              @relation(fields: [societeId], references: [id])
  // Référence interne, facultative ; unique dans la société quand elle est
  // renseignée (deux sociétés peuvent avoir la même).
  code            String?
  // Obligatoire à la création / modification (contrôlé par l'API ; les anciens
  // articles sans code-barres restent lisibles).
  codeBarre       String?
  designation     String
  marque          String?
  unit            String?
  img             String?
  prixAchat       Decimal              @db.Decimal(12, 3)
  prixVente       Decimal              @db.Decimal(12, 6)
  colisage        Int                  @default(1)
  tva             Decimal              @default(19) @db.Decimal(5, 2)
  // FODEC (% du prix HT, 0 ou 1) : la TVA se calcule sur HT + FODEC.
  fodec           Decimal              @default(0) @db.Decimal(5, 2)
  // Prix de gros HT (facultatif).
  prixGros        Decimal?             @db.Decimal(12, 6)
  // Date à laquelle l'admin a confirmé que l'article n'a aucun stock au dépôt.
  stockVerifieAt  DateTime?
  // Exclu du suivi de péremption (aucune date applicable à cet article).
  sansPeremption  Boolean              @default(false)
  // Dernière recherche automatique de photo (Open Food Facts) : évite de la refaire pour rien.
  photoCherchee   DateTime?
  lots            LotDepot[]
  historiquePrix  HistoriquePrix[]
  emplacements    EmplacementArticle[]
  // Stock minimum (en pièces) : en dessous, l'article est « stock bas » sur le plan 3D. Vide : un colis.
  stockMini       Decimal?             @db.Decimal(12, 3)
  // Mise en avant (bleu sur le plan 3D) : nouveauté ou promotion, jusqu'à la date indiquée (vide : sans fin).
  etiquette       EtiquetteArticle?
  etiquetteJusqua DateTime?            @db.Date
  // Autres codes-barres du même produit (variantes : saveur, couleur, modèle…) : les scanner ramène cet article.
  codesBarres     CodeBarreArticle[]
  // Catégorie (la plus précise : sous-catégorie si elle existe).
  categorieId     String?
  categorie       Categorie?           @relation(fields: [categorieId], references: [id])
  // Position dans le catalogue : ordre des lignes du fichier importé, puis les
  // articles créés dans l'app à la suite.
  ordre           Int?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?

  stockCamion      StockCamion[]
  stockDepot       StockDepot?
  mouvementsDepot  MouvementDepot[]
  lignesEntree     LigneEntreeDepot[]
  lignesInventaire LigneInventaire[]
  lignesFacture    LigneFacture[]
  lignesRetour     LigneRetour[]
  lignesChargement LigneChargement[]
  mouvementsStock  MouvementStock[]

  @@unique([societeId, code])
  @@index([updatedAt])
  @@map("articles")
}

model Client {
  id          String    @id @default(uuid())
  societeId   String
  societe     Societe   @relation(fields: [societeId], references: [id])
  // Matricule fiscal, unique dans la société.
  code        String
  nomCommerce String
  responsable String?
  telephone   String?
  adresse     String?
  ville       String?
  latitude    Float?
  longitude   Float?
  actif       Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  factures  Facture[]
  retours   Retour[]
  paiements Paiement[]
  visites   Visite[]

  @@unique([societeId, code])
  @@index([updatedAt])
  @@map("clients")
}

model ChargementCamion {
  id        String             @id @default(uuid())
  vendeurId String
  vendeur   User               @relation(fields: [vendeurId], references: [id])
  sens      SensMouvementStock @default(CHARGEMENT)
  // N° de bon de chargement / retour (facultatif).
  reference String?
  date      DateTime           @default(now())
  lignes    LigneChargement[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  // Suppression par l\'admin : le stock est rétabli et le document reste
  // visible dans l\'historique, marqué supprimé.
  deletedAt DateTime?

  @@index([updatedAt])
  @@index([vendeurId])
  @@map("chargements_camion")
}

model LigneChargement {
  id             String           @id @default(uuid())
  chargementId   String
  chargement     ChargementCamion @relation(fields: [chargementId], references: [id])
  articleId      String
  article        Article          @relation(fields: [articleId], references: [id])
  quantiteColis  Decimal          @db.Decimal(12, 3)
  // Quantité réellement transférée en unités (la saisie peut se faire en
  // colis ou directement en unités).
  quantiteUnites Decimal?         @db.Decimal(12, 3)

  @@map("lignes_chargement")
}

// Stock du dépôt central, une ligne par article.
model StockDepot {
  id        String   @id @default(uuid())
  articleId String   @unique
  article   Article  @relation(fields: [articleId], references: [id])
  quantite  Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt DateTime @updatedAt

  @@map("stock_depot")
}

model MouvementDepot {
  id        String             @id @default(uuid())
  articleId String
  article   Article            @relation(fields: [articleId], references: [id])
  sens      SensMouvementDepot
  quantite  Decimal            @db.Decimal(12, 3)
  vendeurId String?
  vendeur   User?              @relation("MouvementDepotVendeur", fields: [vendeurId], references: [id])
  reference String?
  date      DateTime           @default(now())
  entreeId  String?
  entree    EntreeDepot?       @relation(fields: [entreeId], references: [id])

  @@index([articleId])
  @@index([entreeId])
  @@map("mouvements_depot")
}

// Réception de marchandise au dépôt (bon de livraison). Supprimable : le
// stock dépôt est alors diminué d'autant.
model EntreeDepot {
  id         String             @id @default(uuid())
  societeId  String
  societe    Societe            @relation(fields: [societeId], references: [id])
  reference  String?
  date       DateTime           @default(now())
  adminId    String?
  admin      User?              @relation("EntreeDepotAdmin", fields: [adminId], references: [id])
  createdAt  DateTime           @default(now())
  deletedAt  DateTime?
  lignes     LigneEntreeDepot[]
  mouvements MouvementDepot[]

  @@index([date])
  @@index([societeId])
  @@map("entrees_depot")
}

model LigneEntreeDepot {
  id             String      @id @default(uuid())
  entreeId       String
  entree         EntreeDepot @relation(fields: [entreeId], references: [id], onDelete: Cascade)
  articleId      String
  article        Article     @relation(fields: [articleId], references: [id])
  // En pièces.
  quantite       Decimal     @db.Decimal(12, 3)
  // Date d'expiration des pièces reçues (si connue).
  dateExpiration DateTime?   @db.Date
  // Prix d'achat HT de la réception, quand il a été saisi (le prix de l'article change avec).
  prixAchat      Decimal?    @db.Decimal(12, 6)

  @@map("lignes_entree_depot")
}

// Inventaire du stock d'un camion. Tant qu'il est EN_COURS, les quantités
// théoriques suivent le stock camion en temps réel ; à la validation, elles
// sont figées et le stock camion est remplacé par les quantités comptées.
model Inventaire {
  id             String            @id @default(uuid())
  societeId      String
  societe        Societe           @relation(fields: [societeId], references: [id])
  // Camion inventorié ; null = inventaire du dépôt de la société.
  vendeurId      String?
  vendeur        User?             @relation("InventaireVendeur", fields: [vendeurId], references: [id])
  adminId        String
  admin          User              @relation("InventaireAdmin", fields: [adminId], references: [id])
  statut         StatutInventaire  @default(EN_COURS)
  note           String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  dateValidation DateTime?
  lignes         LigneInventaire[]

  @@index([vendeurId, createdAt])
  @@index([societeId, createdAt])
  @@map("inventaires")
}

model LigneInventaire {
  id                String      @id @default(uuid())
  inventaireId      String
  inventaire        Inventaire  @relation(fields: [inventaireId], references: [id], onDelete: Cascade)
  articleId         String
  article           Article     @relation(fields: [articleId], references: [id])
  quantiteReelle    Decimal     @db.Decimal(12, 3)
  // Figée à la validation (null tant que l'inventaire est en cours).
  quantiteTheorique Decimal?    @db.Decimal(12, 3)
  motif             MotifEcart?
  note              String?
  updatedAt         DateTime    @updatedAt

  @@unique([inventaireId, articleId])
  @@map("lignes_inventaire")
}

// Solde courant du stock embarqué par vendeur/article (dénormalisé pour lecture rapide)
model StockCamion {
  id        String   @id @default(uuid())
  vendeurId String
  vendeur   User     @relation(fields: [vendeurId], references: [id])
  articleId String
  article   Article  @relation(fields: [articleId], references: [id])
  quantite  Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt DateTime @updatedAt

  @@unique([vendeurId, articleId])
  @@index([updatedAt])
  @@map("stock_camion")
}

model MouvementStock {
  id        String             @id @default(uuid())
  vendeurId String
  vendeur   User               @relation(fields: [vendeurId], references: [id])
  articleId String
  article   Article            @relation(fields: [articleId], references: [id])
  sens      SensMouvementStock
  quantite  Decimal            @db.Decimal(12, 3)
  reference String?
  date      DateTime           @default(now())

  @@index([vendeurId, articleId])
  @@map("mouvements_stock")
}

model Facture {
  id           String        @id @default(uuid())
  numero       String        @unique
  clientId     String
  client       Client        @relation(fields: [clientId], references: [id])
  vendeurId    String
  vendeur      User          @relation(fields: [vendeurId], references: [id])
  date         DateTime      @default(now())
  typeVente    TypeVente     @default(COMPTANT)
  modePaiement ModePaiement?
  montantHT    Decimal       @db.Decimal(12, 3)
  montantTVA   Decimal       @db.Decimal(12, 3)
  montantTTC   Decimal       @db.Decimal(12, 3)
  statut       StatutFacture @default(VALIDEE)
  latitude     Float?
  longitude    Float?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  lignes    LigneFacture[]
  paiements Paiement[]

  @@index([updatedAt])
  @@index([clientId])
  @@index([vendeurId])
  @@map("factures")
}

model LigneFacture {
  id           String  @id @default(uuid())
  factureId    String
  facture      Facture @relation(fields: [factureId], references: [id])
  articleId    String
  article      Article @relation(fields: [articleId], references: [id])
  quantite     Decimal @db.Decimal(12, 3)
  prixUnitaire Decimal @db.Decimal(12, 6)
  tauxTva      Decimal @db.Decimal(5, 2)
  montantHT    Decimal @db.Decimal(12, 3)
  montantTTC   Decimal @db.Decimal(12, 3)

  @@map("lignes_facture")
}

model Retour {
  id        String        @id @default(uuid())
  clientId  String
  client    Client        @relation(fields: [clientId], references: [id])
  vendeurId String
  date      DateTime      @default(now())
  motif     String?
  lignes    LigneRetour[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  @@index([updatedAt])
  @@map("retours")
}

model LigneRetour {
  id        String  @id @default(uuid())
  retourId  String
  retour    Retour  @relation(fields: [retourId], references: [id])
  articleId String
  article   Article @relation(fields: [articleId], references: [id])
  quantite  Decimal @db.Decimal(12, 3)
  montant   Decimal @db.Decimal(12, 3)

  @@map("lignes_retour")
}

model Paiement {
  id        String       @id @default(uuid())
  clientId  String
  client    Client       @relation(fields: [clientId], references: [id])
  factureId String?
  facture   Facture?     @relation(fields: [factureId], references: [id])
  vendeurId String
  vendeur   User         @relation(fields: [vendeurId], references: [id])
  montant   Decimal      @db.Decimal(12, 3)
  mode      ModePaiement
  reference String?
  date      DateTime     @default(now())
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  @@index([updatedAt])
  @@index([clientId])
  @@map("paiements")
}

// Point GPS enregistré à chaque facture / visite pour le suivi du parcours
model Visite {
  id        String   @id @default(uuid())
  vendeurId String
  vendeur   User     @relation(fields: [vendeurId], references: [id])
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id])
  latitude  Float
  longitude Float
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
  @@index([vendeurId, date])
  @@map("visites")
}

// Arbre de catégories d'une société (catégorie › sous-catégorie ; l'arbre admet plus de
// niveaux, la limite est dans l'API).
model Categorie {
  id          String      @id @default(uuid())
  societeId   String
  societe     Societe     @relation(fields: [societeId], references: [id])
  nom         String
  parentId    String?
  parent      Categorie?  @relation("ArbreCategories", fields: [parentId], references: [id], onDelete: Restrict)
  enfants     Categorie[] @relation("ArbreCategories")
  ordre       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  articles    Article[]
  // Suivi des dates d'expiration (les sous-catégories héritent de leur catégorie).
  perissable  Boolean     @default(false)
  // Jours avant l'expiration où un lot est signalé (30 par défaut).
  alerteJours Int?
  // Produits frais : rangés dans la chambre froide du dépôt (les sous-catégories héritent de leur catégorie).
  froid       Boolean     @default(false)

  @@index([societeId, parentId])
  @@map("categories")
}

// Lot de marchandise au dépôt : une quantité d'un article qui expire à la même date.
// Un article peut avoir plusieurs lots (livraisons de dates différentes). La somme des
// lots d'un article égale son stock dépôt ; la date null = « date inconnue » (stock
// existant avant le suivi, retour de camion…).
model LotDepot {
  id             String    @id @default(uuid())
  articleId      String
  article        Article   @relation(fields: [articleId], references: [id])
  dateExpiration DateTime? @db.Date
  quantite       Decimal   @db.Decimal(12, 3)
  // Bon d'entrée qui a apporté le lot (traçabilité).
  entreeId       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([articleId])
  @@index([dateExpiration])
  @@map("lots_depot")
}

// D'où vient un changement de prix.
// Mise en avant d'un article (affichée en bleu sur le plan 3D du dépôt).
enum EtiquetteArticle {
  NOUVEAU
  PROMOTION
}

enum SourcePrix {
  CREATION
  MODIFICATION
  ENTREE
  IMPORT
}

// Historique des prix d'un article : une ligne à chaque changement de prix d'achat ou de vente
// (les prix en vigueur À PARTIR de `date`). Sert aux courbes de la fiche article.
model HistoriquePrix {
  id        String     @id @default(uuid())
  articleId String
  article   Article    @relation(fields: [articleId], references: [id])
  date      DateTime   @default(now())
  // HT, comme sur l'article.
  prixAchat Decimal    @db.Decimal(12, 6)
  prixVente Decimal    @db.Decimal(12, 6)
  tva       Decimal    @db.Decimal(5, 2)
  fodec     Decimal    @db.Decimal(5, 2)
  source    SourcePrix
  // Bon d'entrée à l'origine du changement.
  entreeId  String?
  adminId   String?

  @@index([articleId, date])
  @@map("prix_historique")
}

// Code-barres supplémentaire d'un article : même produit (marque, unité, prix) dans une autre
// variante (saveur, couleur, modèle…) ou un autre emballage. Unique dans la société, comme le code-barres principal.
model CodeBarreArticle {
  id        String   @id @default(uuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  societeId String
  codeBarre String
  // Variante (« Fraise », « Rouge », « Modèle B »), facultatif.
  libelle   String?
  createdAt DateTime @default(now())

  @@unique([societeId, codeBarre])
  @@index([articleId])
  @@map("articles_codes_barres")
}

// Plan du dépôt en 3D : le bâtiment d'une société (dimensions en mètres), ses étagères et ce qui y est rangé.
model Entrepot {
  id         String         @id @default(uuid())
  societeId  String         @unique
  societe    Societe        @relation(fields: [societeId], references: [id])
  // Dimensions du bâtiment : largeur (axe x) × profondeur (axe z).
  largeur    Float          @default(32)
  profondeur Float          @default(22)
  racks      EntrepotRack[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@map("entrepots")
}

// Une étagère (rack) : `niveaux` étages × `travees` cases de large. (x, z) = son centre au sol, en mètres.
model EntrepotRack {
  id           String               @id @default(uuid())
  entrepotId   String
  entrepot     Entrepot             @relation(fields: [entrepotId], references: [id], onDelete: Cascade)
  nom          String
  allee        String
  x            Float
  z            Float
  // 0 : longueur le long de l'axe x ; 90 : le long de l'axe z.
  rotation     Int                  @default(0)
  niveaux      Int                  @default(4)
  travees      Int                  @default(5)
  emplacements EmplacementArticle[]
  createdAt    DateTime             @default(now())

  @@index([entrepotId])
  @@map("entrepot_racks")
}

// Une quantité d'un article rangée dans une case (niveau, travée) d'une étagère. Indicatif : il ne bloque
// aucun mouvement de stock ; le stock reste celui du dépôt (stock_depot).
model EmplacementArticle {
  id        String       @id @default(uuid())
  rackId    String
  rack      EntrepotRack @relation(fields: [rackId], references: [id], onDelete: Cascade)
  niveau    Int
  travee    Int
  articleId String
  article   Article      @relation(fields: [articleId], references: [id])
  quantite  Decimal      @db.Decimal(12, 3)
  updatedAt DateTime     @updatedAt

  @@unique([rackId, niveau, travee, articleId])
  @@index([articleId])
  @@map("entrepot_emplacements")
}
