// Schema de la base de données centrale (PostgreSQL)
// Toutes les entités synchronisables utilisent un id UUID (généré côté mobile
// si créées hors-ligne) + updatedAt/deletedAt pour permettre une synchronisation
// incrémentale (delta sync) fiable entre le backend et la base locale SQLite du mobile.

generator client {
  provider      = "prisma-client-js"
  // rhel-openssl-3.0.x : moteur des fonctions Vercel.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Connexion directe (sans pooler) pour les migrations ; avec Neon sur Vercel,
  // l'intégration fournit DATABASE_URL (poolée) et DATABASE_URL_UNPOOLED.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  ADMIN
  VENDEUR
}

enum TypeVente {
  COMPTANT
  CREDIT
}

enum ModePaiement {
  ESPECES
  CHEQUE
  VIREMENT
  TPE
  // Règlement fournisseur par traite (effet de commerce) ; son numéro va dans la référence.
  TRAITE
}

// Document d'achat reçu d'un fournisseur : bon de livraison (BL) ou facture.
enum TypeAchat {
  BL
  FACTURE
  // Bon d'entrée : achat sans papier légal (numéro automatique, fournisseur facultatif → « Divers »).
  ENTREE
}

enum StatutFacture {
  VALIDEE
  ANNULEE
}

// Effet sur le stock camion : CHARGEMENT +, RETOUR (camion -> dépôt) -,
// VENTE -, RETOUR_CLIENT (produit repris chez un client) +, AJUSTEMENT signé.
enum SensMouvementStock {
  CHARGEMENT
  RETOUR
  VENTE
  AJUSTEMENT
  RETOUR_CLIENT
}

// Mouvements du dépôt central : réception fournisseur (ENTREE), sortie vers un
// camion (CHARGEMENT), retour des invendus d'un camion (RETOUR).
enum SensMouvementDepot {
  ENTREE
  CHARGEMENT
  RETOUR
  AJUSTEMENT
  // Caisse du supermarché : vente au comptoir (sortie) et retour d'un client (entrée).
  VENTE_CAISSE
  RETOUR_CAISSE
}

enum StatutInventaire {
  EN_COURS
  VALIDE
}

// Justification d'un écart d'inventaire, saisie par l'admin.
enum MotifEcart {
  ENDOMMAGE
  PERDU
  ECHANTILLON
  AUTRE
}

// Société (entreprise) gérée par l'admin : chacune a ses propres articles,
// clients, dépôt, vendeurs (et donc camions) et bons. L'admin passe de l'une à
// l'autre ; un vendeur appartient à une seule société.
// Dépôt (distribution) ou supermarché : le supermarché a tout le dépôt, plus ses caisses.
enum TypeSociete {
  DEPOT
  SUPERMARCHE
}

model Societe {
  id              String    @id @default(uuid())
  type            TypeSociete @default(DEPOT)
  // Supermarché : commission retenue par l'émetteur sur les tickets restaurant (%), les bons d'achat n'en ont pas.
  commissionTicketResto Decimal @default(10) @db.Decimal(5, 2)
  // Préfixe des comptes vendeurs (RC → RC-V001) : codes uniques dans toute l'app.
  code            String    @unique
  nom             String
  activite        String?
  matriculeFiscal String?
  adresse         String?
  telephone       String?
  logo            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  articles               Article[]
  clients                Client[]
  users                  User[]
  entrees                EntreeDepot[]
  inventaires            Inventaire[]
  categories             Categorie[]
  entrepot               Entrepot?
  facturesVente          FactureVente[]
  fournisseurs           Fournisseur[]
  achats                 Achat[]
  reglementsFournisseurs ReglementFournisseur[]
  depenses               Depense[]
  categoriesDepense      CategorieDepense[]
  collectes              Collecte[]
  comptesBancaires       CompteBancaire[]
  promotions             Promotion[]
  caisses                Caisse[]
  caissiers              Caissier[]
  famillesTouches        FamilleTouche[]
  brouillonTouches       BrouillonTouches?
  sessionsCaisse         SessionCaisse[]
  ticketsCaisse          TicketCaisse[]

  @@map("societes")
}

model User {
  id               String   @id @default(uuid())
  code             String   @unique
  nom              String
  email            String?  @unique
  telephone        String?
  // Société du vendeur ; l'admin (null) gère toutes les sociétés.
  societeId        String?
  societe          Societe? @relation(fields: [societeId], references: [id])
  // Véhicule du vendeur, imprimé sur ses bons de sortie.
  voiture          String?
  matriculeVoiture String?
  passwordHash     String
  role             Role     @default(VENDEUR)
  actif            Boolean  @default(true)
  // Incrémenté à la désactivation du compte ou au changement de mot de passe :
  // les jetons émis avant deviennent invalides (déconnexion immédiate).
  sessionVersion   Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  stockCamion      StockCamion[]
  chargements      ChargementCamion[]
  factures         Facture[]
  paiements        Paiement[]
  visites          Visite[]
  mouvementsStock  MouvementStock[]
  mouvementsDepot  MouvementDepot[]   @relation("MouvementDepotVendeur")
  entreesDepot     EntreeDepot[]      @relation("EntreeDepotAdmin")
  inventaires      Inventaire[]       @relation("InventaireVendeur")
  inventairesFaits Inventaire[]       @relation("InventaireAdmin")
  depenses         Depense[]          @relation("DepenseVendeur")
  collectes        Collecte[]

  @@map("users")
}

model Article {
  id              String               @id @default(uuid())
  societeId       String
  societe         Societe              @relation(fields: [societeId], references: [id])
  // Référence interne, facultative ; unique dans la société quand elle est
  // renseignée (deux sociétés peuvent avoir la même).
  code            String?
  // Obligatoire à la création / modification (contrôlé par l'API ; les anciens
  // articles sans code-barres restent lisibles).
  codeBarre       String?
  designation     String
  marque          String?
  unit            String?
  img             String?
  prixAchat       Decimal              @db.Decimal(12, 3)
  prixVente       Decimal              @db.Decimal(12, 6)
  colisage        Int                  @default(1)
  tva             Decimal              @default(19) @db.Decimal(5, 2)
  // FODEC (% du prix HT, 0 ou 1) : la TVA se calcule sur HT + FODEC.
  fodec           Decimal              @default(0) @db.Decimal(5, 2)
  // Prix de gros HT (facultatif).
  prixGros        Decimal?             @db.Decimal(12, 6)
  // Date à laquelle l'admin a confirmé que l'article n'a aucun stock au dépôt.
  stockVerifieAt  DateTime?
  // Exclu du suivi de péremption (aucune date applicable à cet article).
  sansPeremption  Boolean              @default(false)
  // Dernière recherche automatique de photo (Open Food Facts) : évite de la refaire pour rien.
  photoCherchee   DateTime?
  lots            LotDepot[]
  historiquePrix  HistoriquePrix[]
  emplacements    EmplacementArticle[]
  // Stock minimum (en pièces) : en dessous, l'article est « stock bas » sur le plan 3D. Vide : un colis.
  stockMini       Decimal?             @db.Decimal(12, 3)
  // Mise en avant (bleu sur le plan 3D) : nouveauté ou promotion, jusqu'à la date indiquée (vide : sans fin).
  etiquette       EtiquetteArticle?
  etiquetteJusqua DateTime?            @db.Date
  // Autres codes-barres du même produit (variantes : saveur, couleur, modèle…) : les scanner ramène cet article.
  codesBarres     CodeBarreArticle[]
  promotionsLignes  PromotionLigne[] @relation("PromotionArticle")
  touches           Touche[]
  lignesTicket      LigneTicket[]
  promotionsOffert  PromotionLigne[] @relation("PromotionArticleOffert")
  // Catégorie (la plus précise : sous-catégorie si elle existe).
  categorieId     String?
  categorie       Categorie?           @relation(fields: [categorieId], references: [id])
  // Position dans le catalogue : ordre des lignes du fichier importé, puis les
  // articles créés dans l'app à la suite.
  ordre           Int?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?

  stockCamion        StockCamion[]
  stockDepot         StockDepot?
  mouvementsDepot    MouvementDepot[]
  lignesEntree       LigneEntreeDepot[]
  lignesInventaire   LigneInventaire[]
  lignesFacture      LigneFacture[]
  lignesFactureVente LigneFactureVente[]
  lignesAchat        LigneAchat[]
  lignesRetour       LigneRetour[]
  lignesChargement   LigneChargement[]
  mouvementsStock    MouvementStock[]

  @@unique([societeId, code])
  @@index([updatedAt])
  @@index([categorieId])
  @@map("articles")
}

model Client {
  id          String    @id @default(uuid())
  societeId   String
  societe     Societe   @relation(fields: [societeId], references: [id])
  // Matricule fiscal, unique dans la société.
  code        String
  // Référence auto-incrémentée par société (1, 2, 3…), plus simple à citer que le MF.
  ref         Int
  nomCommerce String
  responsable String?
  telephone   String?
  adresse     String?
  ville       String?
  latitude    Float?
  longitude   Float?
  actif       Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  factures      Facture[]
  facturesVente FactureVente[]
  retours       Retour[]
  paiements     Paiement[]
  visites       Visite[]

  @@unique([societeId, code])
  @@unique([societeId, ref])
  @@index([updatedAt])
  @@map("clients")
}

model ChargementCamion {
  id        String             @id @default(uuid())
  vendeurId String
  vendeur   User               @relation(fields: [vendeurId], references: [id])
  sens      SensMouvementStock @default(CHARGEMENT)
  // N° de bon de chargement / retour (facultatif).
  reference String?
  date      DateTime           @default(now())
  lignes    LigneChargement[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  // Suppression par l\'admin : le stock est rétabli et le document reste
  // visible dans l\'historique, marqué supprimé.
  deletedAt DateTime?

  @@index([updatedAt])
  @@index([vendeurId])
  @@map("chargements_camion")
}

model LigneChargement {
  id             String           @id @default(uuid())
  chargementId   String
  chargement     ChargementCamion @relation(fields: [chargementId], references: [id])
  articleId      String
  article        Article          @relation(fields: [articleId], references: [id])
  quantiteColis  Decimal          @db.Decimal(12, 3)
  // Quantité réellement transférée en unités (la saisie peut se faire en
  // colis ou directement en unités).
  quantiteUnites Decimal?         @db.Decimal(12, 3)

  @@map("lignes_chargement")
}

// Stock du dépôt central, une ligne par article.
model StockDepot {
  id        String   @id @default(uuid())
  articleId String   @unique
  article   Article  @relation(fields: [articleId], references: [id])
  quantite  Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt DateTime @updatedAt

  @@map("stock_depot")
}

model MouvementDepot {
  id        String             @id @default(uuid())
  articleId String
  article   Article            @relation(fields: [articleId], references: [id])
  sens      SensMouvementDepot
  quantite  Decimal            @db.Decimal(12, 3)
  vendeurId String?
  vendeur   User?              @relation("MouvementDepotVendeur", fields: [vendeurId], references: [id])
  reference String?
  date      DateTime           @default(now())
  entreeId  String?
  entree    EntreeDepot?       @relation(fields: [entreeId], references: [id])

  @@index([articleId])
  @@index([entreeId])
  @@map("mouvements_depot")
}

// Réception de marchandise au dépôt (bon de livraison). Supprimable : le
// stock dépôt est alors diminué d'autant.
model EntreeDepot {
  id         String             @id @default(uuid())
  societeId  String
  societe    Societe            @relation(fields: [societeId], references: [id])
  reference  String?
  date       DateTime           @default(now())
  adminId    String?
  admin      User?              @relation("EntreeDepotAdmin", fields: [adminId], references: [id])
  createdAt  DateTime           @default(now())
  deletedAt  DateTime?
  lignes     LigneEntreeDepot[]
  mouvements MouvementDepot[]

  @@index([date])
  @@index([societeId])
  @@map("entrees_depot")
}

model LigneEntreeDepot {
  id             String      @id @default(uuid())
  entreeId       String
  entree         EntreeDepot @relation(fields: [entreeId], references: [id], onDelete: Cascade)
  articleId      String
  article        Article     @relation(fields: [articleId], references: [id])
  // En pièces.
  quantite       Decimal     @db.Decimal(12, 3)
  // Date d'expiration des pièces reçues (si connue).
  dateExpiration DateTime?   @db.Date
  // Prix d'achat HT de la réception, quand il a été saisi (le prix de l'article change avec).
  prixAchat      Decimal?    @db.Decimal(12, 6)

  @@map("lignes_entree_depot")
}

// Inventaire du stock d'un camion. Tant qu'il est EN_COURS, les quantités
// théoriques suivent le stock camion en temps réel ; à la validation, elles
// sont figées et le stock camion est remplacé par les quantités comptées.
model Inventaire {
  id             String            @id @default(uuid())
  societeId      String
  societe        Societe           @relation(fields: [societeId], references: [id])
  // Camion inventorié ; null = inventaire du dépôt de la société.
  vendeurId      String?
  vendeur        User?             @relation("InventaireVendeur", fields: [vendeurId], references: [id])
  adminId        String
  admin          User              @relation("InventaireAdmin", fields: [adminId], references: [id])
  statut         StatutInventaire  @default(EN_COURS)
  // Dépôt : catégories inventoriées (avec leurs sous-catégories) ; vide = tout le dépôt.
  categorieIds   String[]          @default([])
  // Nom affiché : « Boissons › Eaux », « Tout le dépôt »…
  libelle        String?
  note           String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  dateValidation DateTime?
  lignes         LigneInventaire[]

  @@index([vendeurId, createdAt])
  @@index([societeId, createdAt])
  @@map("inventaires")
}

model LigneInventaire {
  id                String      @id @default(uuid())
  inventaireId      String
  inventaire        Inventaire  @relation(fields: [inventaireId], references: [id], onDelete: Cascade)
  articleId         String
  article           Article     @relation(fields: [articleId], references: [id])
  quantiteReelle    Decimal     @db.Decimal(12, 3)
  // Figée à la validation (null tant que l'inventaire est en cours).
  quantiteTheorique Decimal?    @db.Decimal(12, 3)
  motif             MotifEcart?
  note              String?
  updatedAt         DateTime    @updatedAt

  @@unique([inventaireId, articleId])
  @@map("lignes_inventaire")
}

// Solde courant du stock embarqué par vendeur/article (dénormalisé pour lecture rapide)
model StockCamion {
  id        String   @id @default(uuid())
  vendeurId String
  vendeur   User     @relation(fields: [vendeurId], references: [id])
  articleId String
  article   Article  @relation(fields: [articleId], references: [id])
  quantite  Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt DateTime @updatedAt

  @@unique([vendeurId, articleId])
  @@index([updatedAt])
  @@map("stock_camion")
}

model MouvementStock {
  id        String             @id @default(uuid())
  vendeurId String
  vendeur   User               @relation(fields: [vendeurId], references: [id])
  articleId String
  article   Article            @relation(fields: [articleId], references: [id])
  sens      SensMouvementStock
  quantite  Decimal            @db.Decimal(12, 3)
  reference String?
  date      DateTime           @default(now())

  @@index([vendeurId, articleId])
  @@map("mouvements_stock")
}

model Facture {
  id             String        @id @default(uuid())
  numero         String        @unique
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id])
  vendeurId      String
  vendeur        User          @relation(fields: [vendeurId], references: [id])
  date           DateTime      @default(now())
  typeVente      TypeVente     @default(COMPTANT)
  modePaiement   ModePaiement?
  montantHT      Decimal       @db.Decimal(12, 3)
  montantTVA     Decimal       @db.Decimal(12, 3)
  montantTTC     Decimal       @db.Decimal(12, 3)
  statut         StatutFacture @default(VALIDEE)
  latitude       Float?
  longitude      Float?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  // Renseigné quand ce bon de livraison a été transformé en facture : il n'apparaît plus comme bon.
  factureVenteId String?
  factureVente   FactureVente? @relation(fields: [factureVenteId], references: [id])

  lignes    LigneFacture[]
  paiements Paiement[]

  @@index([updatedAt])
  @@index([clientId])
  @@index([vendeurId])
  @@map("factures")
}

model LigneFacture {
  id           String  @id @default(uuid())
  factureId    String
  facture      Facture @relation(fields: [factureId], references: [id])
  articleId    String
  article      Article @relation(fields: [articleId], references: [id])
  quantite     Decimal @db.Decimal(12, 3)
  prixUnitaire Decimal @db.Decimal(12, 6)
  tauxTva      Decimal @db.Decimal(5, 2)
  montantHT    Decimal @db.Decimal(12, 3)
  montantTTC   Decimal @db.Decimal(12, 3)
  // Promotion appliquée : pièces offertes (en plus des pièces payées, sorties du stock aussi) et remise HT.
  quantiteOfferte Decimal @default(0) @db.Decimal(12, 3)
  remise          Decimal @default(0) @db.Decimal(12, 3)
  promotionId     String?
  promotion       Promotion? @relation(fields: [promotionId], references: [id])

  @@map("lignes_facture")
}

/// Facture établie en regroupant des bons de livraison (Ventes > Transformation BL en Facture).
model FactureVente {
  id         String   @id @default(uuid())
  societeId  String
  societe    Societe  @relation(fields: [societeId], references: [id])
  // Client des bons regroupés ; vide si la facture mélange plusieurs clients.
  clientId   String?
  client     Client?  @relation(fields: [clientId], references: [id])
  // AAAA/001, numérotation par société et par année.
  numero     String
  date       DateTime @default(now())
  montantHT  Decimal  @db.Decimal(12, 3)
  montantTVA Decimal  @db.Decimal(12, 3)
  montantTTC Decimal  @db.Decimal(12, 3)
  // Droit de timbre ajouté à chaque facture (net à payer = TTC + timbre).
  timbre     Decimal  @default(1) @db.Decimal(12, 3)
  createdAt  DateTime @default(now())

  bons   Facture[]
  lignes LigneFactureVente[]

  @@unique([societeId, numero])
  @@index([clientId])
  @@map("factures_vente")
}

model LigneFactureVente {
  id             String       @id @default(uuid())
  factureVenteId String
  factureVente   FactureVente @relation(fields: [factureVenteId], references: [id])
  articleId      String
  article        Article      @relation(fields: [articleId], references: [id])
  quantite       Decimal      @db.Decimal(12, 3)
  prixUnitaire   Decimal      @db.Decimal(12, 6)
  tauxTva        Decimal      @db.Decimal(5, 2)
  montantHT      Decimal      @db.Decimal(12, 3)
  montantTTC     Decimal      @db.Decimal(12, 3)

  @@map("lignes_facture_vente")
}

model Retour {
  id        String        @id @default(uuid())
  clientId  String
  client    Client        @relation(fields: [clientId], references: [id])
  vendeurId String
  date      DateTime      @default(now())
  motif     String?
  lignes    LigneRetour[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  @@index([updatedAt])
  @@map("retours")
}

model LigneRetour {
  id        String  @id @default(uuid())
  retourId  String
  retour    Retour  @relation(fields: [retourId], references: [id])
  articleId String
  article   Article @relation(fields: [articleId], references: [id])
  quantite  Decimal @db.Decimal(12, 3)
  montant   Decimal @db.Decimal(12, 3)

  @@map("lignes_retour")
}

model Paiement {
  id        String       @id @default(uuid())
  clientId  String
  client    Client       @relation(fields: [clientId], references: [id])
  factureId String?
  facture   Facture?     @relation(fields: [factureId], references: [id])
  vendeurId String
  vendeur   User         @relation(fields: [vendeurId], references: [id])
  montant   Decimal      @db.Decimal(12, 3)
  mode      ModePaiement
  reference String?
  date      DateTime     @default(now())
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  @@index([updatedAt])
  @@index([clientId])
  @@map("paiements")
}

// Point GPS enregistré à chaque facture / visite pour le suivi du parcours
model Visite {
  id        String   @id @default(uuid())
  vendeurId String
  vendeur   User     @relation(fields: [vendeurId], references: [id])
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id])
  latitude  Float
  longitude Float
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
  @@index([vendeurId, date])
  @@map("visites")
}

// Arbre de catégories d'une société (catégorie › sous-catégorie ; l'arbre admet plus de
// niveaux, la limite est dans l'API).
model Categorie {
  id          String      @id @default(uuid())
  societeId   String
  societe     Societe     @relation(fields: [societeId], references: [id])
  nom         String
  parentId    String?
  parent      Categorie?  @relation("ArbreCategories", fields: [parentId], references: [id], onDelete: Restrict)
  enfants     Categorie[] @relation("ArbreCategories")
  ordre       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  articles    Article[]
  // Suivi des dates d'expiration (les sous-catégories héritent de leur catégorie).
  perissable  Boolean     @default(false)
  // Jours avant l'expiration où un lot est signalé (30 par défaut).
  alerteJours Int?
  // Produits frais : rangés dans la chambre froide du dépôt (les sous-catégories héritent de leur catégorie).
  froid       Boolean     @default(false)

  @@index([societeId, parentId])
  @@map("categories")
}

// Lot de marchandise au dépôt : une quantité d'un article qui expire à la même date.
// Un article peut avoir plusieurs lots (livraisons de dates différentes). La somme des
// lots d'un article égale son stock dépôt ; la date null = « date inconnue » (stock
// existant avant le suivi, retour de camion…).
model LotDepot {
  id             String    @id @default(uuid())
  articleId      String
  article        Article   @relation(fields: [articleId], references: [id])
  dateExpiration DateTime? @db.Date
  quantite       Decimal   @db.Decimal(12, 3)
  // Bon d'entrée qui a apporté le lot (traçabilité).
  entreeId       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([articleId])
  @@index([dateExpiration])
  @@map("lots_depot")
}

// D'où vient un changement de prix.
// Mise en avant d'un article (affichée en bleu sur le plan 3D du dépôt).
enum EtiquetteArticle {
  NOUVEAU
  PROMOTION
}

enum SourcePrix {
  CREATION
  MODIFICATION
  ENTREE
  IMPORT
}

// Historique des prix d'un article : une ligne à chaque changement de prix d'achat ou de vente
// (les prix en vigueur À PARTIR de `date`). Sert aux courbes de la fiche article.
model HistoriquePrix {
  id        String     @id @default(uuid())
  articleId String
  article   Article    @relation(fields: [articleId], references: [id])
  date      DateTime   @default(now())
  // HT, comme sur l'article.
  prixAchat Decimal    @db.Decimal(12, 6)
  prixVente Decimal    @db.Decimal(12, 6)
  tva       Decimal    @db.Decimal(5, 2)
  fodec     Decimal    @db.Decimal(5, 2)
  source    SourcePrix
  // Bon d'entrée à l'origine du changement.
  entreeId  String?
  adminId   String?

  @@index([articleId, date])
  @@map("prix_historique")
}

// Code-barres supplémentaire d'un article : même produit (marque, unité, prix) dans une autre
// variante (saveur, couleur, modèle…) ou un autre emballage. Unique dans la société, comme le code-barres principal.
model CodeBarreArticle {
  id        String   @id @default(uuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  societeId String
  codeBarre String
  // Variante (« Fraise », « Rouge », « Modèle B »), facultatif.
  libelle   String?
  createdAt DateTime @default(now())

  @@unique([societeId, codeBarre])
  @@index([articleId])
  @@map("articles_codes_barres")
}

// Plan du dépôt en 3D : le bâtiment d'une société (dimensions en mètres), ses étagères et ce qui y est rangé.
model Entrepot {
  id         String         @id @default(uuid())
  societeId  String         @unique
  societe    Societe        @relation(fields: [societeId], references: [id])
  // Dimensions du bâtiment : largeur (axe x) × profondeur (axe z).
  largeur    Float          @default(32)
  profondeur Float          @default(22)
  racks      EntrepotRack[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@map("entrepots")
}

// Une étagère (rack) : `niveaux` étages × `travees` cases de large. (x, z) = son centre au sol, en mètres.
model EntrepotRack {
  id           String               @id @default(uuid())
  entrepotId   String
  entrepot     Entrepot             @relation(fields: [entrepotId], references: [id], onDelete: Cascade)
  nom          String
  allee        String
  x            Float
  z            Float
  // 0 : longueur le long de l'axe x ; 90 : le long de l'axe z.
  rotation     Int                  @default(0)
  niveaux      Int                  @default(4)
  travees      Int                  @default(5)
  emplacements EmplacementArticle[]
  createdAt    DateTime             @default(now())

  @@index([entrepotId])
  @@map("entrepot_racks")
}

// Une quantité d'un article rangée dans une case (niveau, travée) d'une étagère. Indicatif : il ne bloque
// aucun mouvement de stock ; le stock reste celui du dépôt (stock_depot).
model EmplacementArticle {
  id        String       @id @default(uuid())
  rackId    String
  rack      EntrepotRack @relation(fields: [rackId], references: [id], onDelete: Cascade)
  niveau    Int
  travee    Int
  articleId String
  article   Article      @relation(fields: [articleId], references: [id])
  quantite  Decimal      @db.Decimal(12, 3)
  updatedAt DateTime     @updatedAt

  @@unique([rackId, niveau, travee, articleId])
  @@index([articleId])
  @@map("entrepot_emplacements")
}

// ---------------------------------------------------------------- Achats

// Fournisseur de la société. `ref` : numéro court auto-incrémenté par société (1, 2, 3…).
model Fournisseur {
  id              String    @id @default(uuid())
  societeId       String
  societe         Societe   @relation(fields: [societeId], references: [id])
  ref             Int
  nom             String
  // Fournisseur « Divers » intégré (ref 0, un par société) : achats ponctuels sans fournisseur précis.
  divers          Boolean   @default(false)
  matriculeFiscal String?
  telephone       String?
  email           String?
  adresse         String?
  ville           String?
  contact         String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  achats     Achat[]
  reglements ReglementFournisseur[]
  depenses   Depense[]

  @@unique([societeId, ref])
  @@index([societeId])
  @@map("fournisseurs")
}

// BL ou facture d'un fournisseur. Un BL devient facture quand le fournisseur apporte la facture papier :
// la facture créée regroupe ses BL (`factureId`), qui ne sont plus modifiables.
model Achat {
  id               String      @id @default(uuid())
  societeId        String
  societe          Societe     @relation(fields: [societeId], references: [id])
  fournisseurId    String
  fournisseur      Fournisseur @relation(fields: [fournisseurId], references: [id])
  type             TypeAchat
  // Numéro du document du fournisseur.
  numero           String
  // Achat « Divers » : chez qui (précision libre, propre à ce document).
  fournisseurLibre String?
  date             DateTime
  montantHT        Decimal     @db.Decimal(12, 3)
  montantTVA       Decimal     @db.Decimal(12, 3)
  montantTTC       Decimal     @db.Decimal(12, 3)
  // Droit de timbre : 1 TND sur une facture, rien sur un BL (net à payer = TTC + timbre).
  timbre           Decimal     @default(0) @db.Decimal(12, 3)
  // La marchandise est entrée au dépôt avec ce document (BL, ou facture saisie directement ; pas une facture
  // faite de BL, déjà entrés). Supprimer le document la retire du stock.
  stockAjoute      Boolean     @default(false)
  notes            String?
  // BL : la facture fournisseur qui le regroupe.
  factureId        String?
  facture          Achat?      @relation("AchatFacture", fields: [factureId], references: [id])
  bons             Achat[]     @relation("AchatFacture")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?

  lignes     LigneAchat[]
  reglements ReglementFournisseur[]

  @@index([societeId, type, date])
  @@index([fournisseurId])
  @@index([factureId])
  @@map("achats")
}

model LigneAchat {
  id           String   @id @default(uuid())
  achatId      String
  achat        Achat    @relation(fields: [achatId], references: [id], onDelete: Cascade)
  // Article du catalogue, ou ligne libre (désignation seule).
  articleId    String?
  article      Article? @relation(fields: [articleId], references: [id])
  designation  String
  quantite     Decimal  @db.Decimal(12, 3)
  prixUnitaire Decimal  @db.Decimal(12, 6)
  tauxTva      Decimal  @db.Decimal(5, 2)
  montantHT    Decimal  @db.Decimal(12, 3)
  montantTTC   Decimal  @db.Decimal(12, 3)
  // Date d'expiration des pièces reçues (facultative) : elle crée leur lot au dépôt.
  dateExpiration DateTime? @db.Date

  @@index([achatId])
  @@map("lignes_achat")
}

// Paiement fait à un fournisseur : sur un document (total ou avance), ou avance sur compte (sans document).
model ReglementFournisseur {
  id            String       @id @default(uuid())
  societeId     String
  societe       Societe      @relation(fields: [societeId], references: [id])
  fournisseurId String
  fournisseur   Fournisseur  @relation(fields: [fournisseurId], references: [id])
  achatId       String?
  achat         Achat?       @relation(fields: [achatId], references: [id])
  montant       Decimal      @db.Decimal(12, 3)
  mode          ModePaiement
  reference     String?
  date          DateTime
  // Traite : date d'échéance (par défaut un mois après la date du document réglé).
  echeance      DateTime?
  notes         String?
  // Chèque / traite imprimé par l'app : compte tiré et valeurs imprimées (pour réimprimer à l'identique).
  compteBancaireId String?
  compteBancaire   CompteBancaire? @relation(fields: [compteBancaireId], references: [id])
  impression       Json?
  imprimeLe        DateTime?
  createdAt     DateTime     @default(now())
  deletedAt     DateTime?

  @@index([societeId, date])
  @@index([fournisseurId])
  @@index([achatId])
  @@index([echeance])
  @@map("reglements_fournisseurs")
}

// ---------------------------------------------------------------- Dépenses

// Catégorie de dépense (réparation, carburant, loyer…), modifiable par l'admin.
model CategorieDepense {
  id        String    @id @default(uuid())
  societeId String
  societe   Societe   @relation(fields: [societeId], references: [id])
  nom       String
  ordre     Int       @default(0)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  depenses Depense[]

  @@index([societeId])
  @@map("categories_depense")
}

// Dépense de fonctionnement, payée tout de suite (réparation, outil, carburant, loyer…).
model Depense {
  id            String           @id @default(uuid())
  societeId     String
  societe       Societe          @relation(fields: [societeId], references: [id])
  date          DateTime
  categorieId   String
  categorie     CategorieDepense @relation(fields: [categorieId], references: [id])
  montant       Decimal          @db.Decimal(12, 3)
  mode          ModePaiement
  // N° du chèque ou de la traite, référence du virement.
  reference     String?
  description   String
  // Payé à : un fournisseur de la liste, ou un nom libre.
  fournisseurId String?
  fournisseur   Fournisseur?     @relation(fields: [fournisseurId], references: [id])
  beneficiaire  String?
  // Camion concerné (carburant, réparation) : le vendeur qui le conduit.
  vendeurId     String?
  vendeur       User?            @relation("DepenseVendeur", fields: [vendeurId], references: [id])
  // Photo du reçu.
  photo         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?

  @@index([societeId, date])
  @@index([categorieId])
  @@map("depenses")
}

// ---------------------------------------------------------------- Collectes PDA

// Liste d'articles scannés sur le PDA (application « Collecte »). Terminée, elle s'importe dans un formulaire
// d'articles du PC (BL / facture fournisseur, B° Entrée, BL de vente, chargement, inventaire), une seule fois.
model Collecte {
  id           String    @id
  societeId    String
  societe      Societe   @relation(fields: [societeId], references: [id])
  // Compte qui a envoyé la collecte ; vide pour l'app Scan Stock du dépôt (sans compte).
  userId       String?
  user         User?     @relation(fields: [userId], references: [id])
  // Appareil d'origine (« Scan Stock »).
  appareil     String?
  nom          String?
  // Fin de la saisie sur le PDA.
  termineeLe   DateTime  @default(now())
  // Dernier import dans un formulaire du PC. Une collecte se réimporte autant de fois que voulu ; seul
  // l'appareil (Scan Stock) la supprime.
  importeeLe   DateTime?
  importeeDans String?
  nbImports    Int       @default(0)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  lignes LigneCollecte[]

  @@index([societeId, importeeLe])
  @@map("collectes")
}

model LigneCollecte {
  id         String   @id @default(uuid())
  collecteId String
  collecte   Collecte @relation(fields: [collecteId], references: [id], onDelete: Cascade)
  codeBarre  String
  quantite   Decimal  @db.Decimal(12, 3)
  ordre      Int      @default(0)

  @@index([collecteId])
  @@map("lignes_collecte")
}

// Compte bancaire de la société : imprimé sur ses chèques et ses traites (tiré, domiciliation, RIB).
model CompteBancaire {
  id         String    @id @default(uuid())
  societeId  String
  societe    Societe   @relation(fields: [societeId], references: [id])
  banque     String
  agence     String?
  // RIB tunisien : 20 chiffres.
  rib        String
  titulaire  String?
  // Lieu de création imprimé (ville de la société).
  ville      String?
  parDefaut  Boolean   @default(false)
  // Positions d'impression des chèques et des traites de ce compte ({ CHEQUE: …, TRAITE: … }), réglées une fois.
  gabarits   Json?
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  reglements ReglementFournisseur[]

  @@index([societeId])
  @@map("comptes_bancaires")
}

// Promotions (Commercial › Promotions) : prix promo sur une période, ou vente en lot (5 modes). Appliquées
// automatiquement sur les BL de vente (PC et application des vendeurs) pendant leur période.
enum TypePromotion {
  PRIX
  LOT
}

enum ModeLot {
  // Un article acheté, un autre article offert.
  CADEAU
  // 1 + 1 gratuit.
  UN_PLUS_UN
  // 2e à moitié prix.
  DEUXIEME_MOITIE
  // N achetés + 1 gratuit (2+1, 3+1…).
  N_PLUS_UN
  // Lot de N pièces à un prix (lot de 10 yaourts = 8 DT).
  PRIX_LOT
}

model Promotion {
  id        String         @id @default(uuid())
  societeId String
  societe   Societe        @relation(fields: [societeId], references: [id])
  type      TypePromotion
  mode      ModeLot?
  // PR-26/0001 (prix), LT-26/0001 (lot) : numéro automatique par société, type et année.
  numero    String
  libelle   String?
  dateDebut DateTime       @db.Date
  dateFin   DateTime       @db.Date
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?
  lignes    PromotionLigne[]
  lignesFacture LigneFacture[]

  @@unique([societeId, numero])
  @@index([societeId, dateDebut, dateFin])
  @@map("promotions")
}

model PromotionLigne {
  id              String    @id @default(uuid())
  promotionId     String
  promotion       Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  articleId       String
  article         Article   @relation("PromotionArticle", fields: [articleId], references: [id])
  // Prix : nouveau prix de vente HT (comme l'article, FODEC compris dans le TTC affiché).
  prixPromo       Decimal?  @db.Decimal(12, 6)
  // Article offert : l'article donné et combien pour une pièce achetée.
  articleOffertId String?
  articleOffert   Article?  @relation("PromotionArticleOffert", fields: [articleOffertId], references: [id])
  quantiteOfferte Decimal?  @db.Decimal(12, 3)
  // N + 1 : nombre de pièces achetées pour une offerte.
  seuil           Int?
  // Prix du lot : nombre de pièces du lot et son prix HT.
  tailleLot       Int?
  prixLot         Decimal?  @db.Decimal(12, 6)
  ordre           Int       @default(0)

  @@index([promotionId])
  @@index([articleId])
  @@map("promotions_lignes")
}

// ---------------------------------------------------------------- Caisse du supermarché

// Poste de caisse (TPV), géré par l'admin. L'application de caisse s'y associe une fois avec un code
// d'appairage, puis s'authentifie avec sa clé (gardée seulement sous forme d'empreinte).
model Caisse {
  id             String    @id @default(uuid())
  societeId      String
  societe        Societe   @relation(fields: [societeId], references: [id])
  numero         Int
  nom            String
  actif          Boolean   @default(true)
  // Le caissier compte les espèces du tiroir à la clôture (sinon clôture « à l'aveugle » : il remet la recette
  // avec un papier, le responsable saisit le montant remis dans l'application de gestion).
  comptageCaissier Boolean @default(false)
  cleEmpreinte   String?   @unique
  codeAppairage  String?
  codeExpireLe   DateTime?
  appaireeLe     DateTime?
  derniereSyncLe DateTime?
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?
  sessions       SessionCaisse[]
  tickets        TicketCaisse[]

  @@unique([societeId, numero])
  @@map("caisses")
}

// Caissier : se connecte à la caisse avec son code (chiffres), ses droits limitent les actions sensibles.
model Caissier {
  id        String    @id @default(uuid())
  societeId String
  societe   Societe   @relation(fields: [societeId], references: [id])
  nom       String
  codeHash  String
  // { remise, annulerLigne, annulerTicket, retour, prelevement, rapportX, cloture, tiroir }
  droits    Json
  actif     Boolean   @default(true)
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  sessions  SessionCaisse[]
  tickets   TicketCaisse[]

  @@index([societeId])
  @@map("caissiers")
}

// Touches rapides de la caisse : familles (colonne de gauche) et leurs articles (sans étiquette à scanner).
model FamilleTouche {
  id        String   @id @default(uuid())
  societeId String
  societe   Societe  @relation(fields: [societeId], references: [id])
  nom       String
  couleur   String
  ordre     Int      @default(0)
  touches   Touche[]

  @@index([societeId])
  @@map("caisse_familles")
}

// Brouillon des touches rapides : l'admin range familles et articles, enregistre, et n'envoie aux caisses qu'au
// clic « Synchroniser » (les tables ci-dessus restent la version publiée, téléchargée par les caisses).
model BrouillonTouches {
  societeId String   @id
  societe   Societe  @relation(fields: [societeId], references: [id])
  contenu   Json
  updatedAt DateTime @updatedAt

  @@map("caisse_touches_brouillons")
}

model Touche {
  id        String        @id @default(uuid())
  familleId String
  famille   FamilleTouche @relation(fields: [familleId], references: [id], onDelete: Cascade)
  articleId String
  article   Article       @relation(fields: [articleId], references: [id])
  libelle   String?
  couleur   String?
  ordre     Int           @default(0)

  @@index([familleId])
  @@map("caisse_touches")
}

enum StatutSessionCaisse {
  OUVERTE
  CLOTUREE
}

// Session d'un caissier sur une caisse : fond de caisse à l'ouverture, clôture Z (espèces comptées).
model SessionCaisse {
  id              String              @id
  societeId       String
  societe         Societe             @relation(fields: [societeId], references: [id])
  caisseId        String
  caisse          Caisse              @relation(fields: [caisseId], references: [id])
  caissierId      String
  caissier        Caissier            @relation(fields: [caissierId], references: [id])
  statut          StatutSessionCaisse @default(OUVERTE)
  ouverteLe       DateTime
  fondCaisse      Decimal             @db.Decimal(12, 3)
  clotureeLe      DateTime?
  numeroZ         Int?
  especesComptees Decimal?            @db.Decimal(12, 3)
  // Recette en espèces remise au responsable (hors fond de caisse), saisie depuis le papier du caissier.
  especesRemises  Decimal?            @db.Decimal(12, 3)
  remiseSaisieLe  DateTime?
  remiseSaisiePar String?
  tickets         TicketCaisse[]
  mouvements      MouvementCaisse[]

  @@index([societeId, ouverteLe])
  @@index([caisseId])
  @@map("caisse_sessions")
}

enum TypeTicket {
  VENTE
  RETOUR
}

enum ModeReglementCaisse {
  ESPECES
  TPE
  CHEQUE
  TICKET_RESTO
  BON_ACHAT
}

// Ticket de caisse (vente ou retour) : prix TTC, remises, règlements. Envoyé par la caisse (hors ligne possible).
model TicketCaisse {
  id         String        @id
  societeId  String
  societe    Societe       @relation(fields: [societeId], references: [id])
  caisseId   String
  caisse     Caisse        @relation(fields: [caisseId], references: [id])
  sessionId  String
  session    SessionCaisse @relation(fields: [sessionId], references: [id])
  caissierId String
  caissier   Caissier      @relation(fields: [caissierId], references: [id])
  numero     Int
  date       DateTime
  type       TypeTicket    @default(VENTE)
  montantHT  Decimal       @db.Decimal(12, 3)
  montantTVA Decimal       @db.Decimal(12, 3)
  montantTTC Decimal       @db.Decimal(12, 3)
  // Remise sur le ticket entier (TTC), en plus des remises de lignes.
  remise     Decimal       @default(0) @db.Decimal(12, 3)
  rendu      Decimal       @default(0) @db.Decimal(12, 3)
  createdAt  DateTime      @default(now())
  lignes     LigneTicket[]
  paiements  PaiementTicket[]

  @@unique([caisseId, numero])
  @@index([societeId, date])
  @@index([sessionId])
  @@map("caisse_tickets")
}

model LigneTicket {
  id              String       @id @default(uuid())
  ticketId        String
  ticket          TicketCaisse @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  articleId       String
  article         Article      @relation(fields: [articleId], references: [id])
  quantite        Decimal      @db.Decimal(12, 3)
  // Prix de vente TTC d'une pièce (prix promo compris).
  prixUnitaire    Decimal      @db.Decimal(12, 3)
  tauxTva         Decimal      @db.Decimal(5, 2)
  remise          Decimal      @default(0) @db.Decimal(12, 3)
  montantTTC      Decimal      @db.Decimal(12, 3)
  montantHT       Decimal      @db.Decimal(12, 3)
  quantiteOfferte Decimal      @default(0) @db.Decimal(12, 3)
  promotionId     String?
  ordre           Int          @default(0)

  @@index([ticketId])
  @@index([articleId])
  @@map("caisse_tickets_lignes")
}

model PaiementTicket {
  id        String              @id @default(uuid())
  ticketId  String
  ticket    TicketCaisse        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  mode      ModeReglementCaisse
  montant   Decimal             @db.Decimal(12, 3)
  // TPE : n° d'autorisation du ticket de carte ; chèque : n° du chèque.
  reference String?
  // Ticket restaurant : commission de l'émetteur (taux de la société au moment de la vente).
  commission Decimal            @default(0) @db.Decimal(12, 3)

  @@index([ticketId])
  @@map("caisse_tickets_paiements")
}

enum TypeMouvementCaisse {
  PRELEVEMENT
  APPORT
}

// Prélèvement (espèces retirées du tiroir) ou apport en cours de session.
model MouvementCaisse {
  id        String              @id
  sessionId String
  session   SessionCaisse       @relation(fields: [sessionId], references: [id])
  type      TypeMouvementCaisse
  montant   Decimal             @db.Decimal(12, 3)
  motif     String?
  date      DateTime

  @@index([sessionId])
  @@map("caisse_mouvements")
}
